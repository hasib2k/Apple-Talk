# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=mysql://root:@localhost:3306/mangotalk
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ─── WebRTC / TURN ────────────────────────────────────────
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:localhost:3478
TURN_USERNAME=dev
TURN_CREDENTIAL=devpassword

# ─── AWS (Phase 2 — image sharing) ───────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=mangotalk-images-dev

# ─── Payments (Phase 3) ───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Admin ────────────────────────────────────────────────
ADMIN_API_KEY=change_this_to_a_secret_admin_key

# ─── Monitoring ───────────────────────────────────────────
SENTRY_DSN=

# ─── Frontend (Vite — prefix with VITE_) ─────────────────
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
VITE_STUN_URL=stun:stun.l.google.com:19302
