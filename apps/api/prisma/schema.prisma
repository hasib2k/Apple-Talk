generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & auth ────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  deviceId     String    @unique @db.VarChar(64) // anonymous device fingerprint
  googleId     String?   @unique @db.VarChar(64)
  email        String?   @unique @db.VarChar(255)
  isLinked     Boolean   @default(false) // true = signed in with Google
  anonAlias    String    @db.VarChar(60) // display name
  isBanned     Boolean   @default(false)
  banUntil     DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions              Session[]
  meetingsHosted        Meeting[]            @relation("MeetingHost")
  meetingParticipations MeetingParticipant[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique @db.VarChar(512)
  deviceInfo Json
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IpBan {
  id        String    @id @default(cuid())
  ip        String    @unique @db.VarChar(64)
  reason    String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([ip])
}

// ─── Meetings (Google-Meet-style group audio) ────────────────────────────────

model Meeting {
  id              String    @id @default(cuid())
  code            String    @unique @db.VarChar(32) // shareable link slug
  title           String    @db.VarChar(120)
  hostId          String
  status          String    @default("live") @db.VarChar(16) // 'live' | 'ended'
  audienceCanAsk  Boolean   @default(true) // raise-hand allowed
  everyoneSpeaks  Boolean   @default(false) // small-meeting mode: all join as speaker
  chatEnabled     Boolean   @default(false) // host-gated: chat closed until host opens it
  maxParticipants Int       @default(5000)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  host         User                 @relation("MeetingHost", fields: [hostId], references: [id])
  participants MeetingParticipant[]

  @@index([hostId])
  @@index([status])
}

model MeetingParticipant {
  id          String    @id @default(cuid())
  meetingId   String
  userId      String? // null for pure-guest (dev only)
  displayName String    @db.VarChar(60)
  role        String    @default("audience") @db.VarChar(16) // 'host' | 'speaker' | 'audience'
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([userId])
}
